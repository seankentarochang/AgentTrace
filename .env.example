# Gemini API key (Track 3). Leave empty to keep the assistant disabled.
# Required for voice: Gemini Live is Gemini-API-only (OpenRouter can't proxy it).
GEMINI_API_KEY=

# Voice model for the Gemini Live session.
# gemini-3.8-live                    — low-latency default
# gemini-3.8-live-extended-thinking  — background reasoning, multi-tool workflows
# GEMINI_LIVE_MODEL=gemini-3.8-live

# OpenRouter key. When set, the assistant uses OpenRouter instead of Gemini.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=deepseek/deepseek-v4.1-flash

# Collector
AGENTTRACE_COLLECTOR_URL=http://localhost:8787
COLLECTOR_PORT=8787
# Unset = memory only. Set to a directory to persist events as JSONL.
# AGENTTRACE_DATA_DIR=./data
# Payloads larger than this are replaced by a truncated preview at ingest.
# AGENTTRACE_MAX_PAYLOAD_BYTES=65536

# A2A proxy -> target demo agent
A2A_PROXY_PORT=8800
A2A_TARGET_URL=http://localhost:9101

# Demo agents
RESEARCHER_PORT=9101
REVIEWER_PORT=9102
COORDINATOR_PORT=9103
